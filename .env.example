# Speechmatics API key (get from https://portal.speechmatics.com/)
# For local Mac runs, start.sh loads this from Keychain (service: god-mode, account: speechmatics)
SPEECHMATICS_API_KEY=

# Optional overrides
# HOST=127.0.0.1
# PORT=8765
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ATC_OPENROUTER_MODEL=deepseek/deepseek-chat

# Fleet adapter: hybrid (default) | local | demo
# hybrid = hackathon demo workers + live God Mode stack processes
# local  = discover God Mode processes only (do not spawn demo workers)
# demo   = the 3 fake workers only
ATC_ADAPTER=hybrid
# GOD_STACK=/Users/simeong/local-claude-offline-stack

# Quiet god-rt steer timeout (seconds)
# ATC_GOD_RT_TIMEOUT=45
